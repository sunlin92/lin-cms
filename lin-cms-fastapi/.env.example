# 复制为 .env 并按需修改；所有变量前缀 LIN_
LIN_ENV=development
# 必填：python -c 'import secrets; print(secrets.token_hex(32))'
LIN_SECRET_KEY=
# 默认 SQLite 文件；可切换 postgresql+psycopg2://... 或 mysql+pymysql://...
LIN_DATABASE_URL=sqlite:///./data/lincms.db
# 逗号分隔的 CORS 来源
LIN_CORS_ORIGINS=http://localhost:5173
# 首次初始化 root 用户的密码（生产必须改为强密码）
LIN_BOOTSTRAP_ADMIN_PASSWORD=123456
# 文件上传
LIN_UPLOAD_DIR=assets
LIN_SITE_DOMAIN=
# 限流
LIN_RATE_LIMIT_ENABLED=true

# ---- Agent 接入（docs/04 §12；Token 摘要采用无 pepper 高熵 SHA-256，无需 PEPPER） ----
#LIN_AGENT_TOKEN_DEFAULT_TTL_DAYS=90
#LIN_AGENT_TOKEN_MAX_TTL_DAYS=365
#LIN_AGENT_TOKEN_MAX_ACTIVE_PER_USER=20
#LIN_AGENT_AUDIT_RETENTION_DAYS=180
#LIN_AGENT_CONTENT_MAX_RECORD_BYTES=65536
#LIN_AGENT_CONTENT_MAX_FIELDS=100
#LIN_AGENT_RATE_LIMIT_ENABLED=true
#LIN_AGENT_RATE_LIMIT_PER_MINUTE=120
#LIN_AGENT_CONTENT_FILTER_SCAN_LIMIT=1000
