# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 120

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.md]
# Markdown 行尾双空格有语义，不裁剪
trim_trailing_whitespace = false
